{
  "name": "fandomwiki-generator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node src/cli.js build",
    "validate": "node src/cli.js validate",
    "dev": "node src/cli.js preview",
    "preview": "node src/cli.js preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "check": "npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "markdown-it": "^15.0.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "vitest": "^5.0.4"
  }
}
